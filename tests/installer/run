#!/usr/bin/env bash
# Installs Agent OS from the published ISO through its console, then boots only what it wrote to the disk.
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
vm="$repo/tests/vm/vm"
guest=/opt/aos-tests/tests
key=$repo/.vm/id_ed25519
log=$repo/.vm/serial.log
source "$repo/tests/integration/guest/lib.sh"

# The console is the serial port. Text is matched past the last match, so an old prompt cannot satisfy a new one.
position=0
start_console() { position=$(stat -c %s "$log"); }
await() { # <text> [seconds]
	local _ at
	for _ in $(seq 1 $((${2:-180} * 5))); do
		at=$(tail -c +$((position + 1)) "$log" | grep -abFo -- "$1" | head -n1 | cut -d: -f1 || true)
		if [[ -n $at ]]; then
			position=$((position + at + ${#1}))
			return 0
		fi
		sleep 0.2
	done
	echo "FAIL: the console never showed: $1" >&2
	exit 1
}
# QEMU drops unread input when the connection closes, so it stays open until the serial port has taken the line.
type_line() { { printf '%s\n' "$1"; sleep 1; } > /dev/tcp/127.0.0.1/10023; }

step() { # <script> [args...]
	echo "### $1"
	"$vm" ssh "sudo $guest/$1.sh ${*:2}"
}
copy_tests() {
	tar -C "$repo" -cf - tests .build/package | "$vm" ssh 'sudo mkdir -p /opt/aos-tests && sudo tar -C /opt/aos-tests --no-same-owner -xf - && sudo chmod -R a+rX /opt/aos-tests'
}
host_key() { ssh-keyscan -t ed25519 -p 10022 127.0.0.1 2>/dev/null | ssh-keygen -l -f - | cut -d" " -f2; }
reported_host_key() { grep -a "Host key:" "$log" | tail -n1 | cut -d" " -f4; }

"$repo/packaging/build-iso"
iso=$(echo "$repo"/.build/installer/agentos_*.iso)
eq "the published checksum matches" 0 "$(cd "$(dirname "$iso")" && status_of sha256sum -c "$(basename "$iso").sha256")"

echo "### BIOS: the key is pasted at the console"
"$vm" installer "$iso"
start_console
type_line ""
await "Key: "
type_line "not a key"
await "That is not an SSH public key."
await "Key: "
type_line "-----BEGIN OPENSSH PRIVATE KEY-----"
await "That is not an SSH public key."
await "Key: "
type_line "$(cat "$key.pub")"
await "Disk to use: "
type_line "sr0"
await "sr0 is not one of the listed disks."
await "Disk to use: "
type_line "vda"
await "Type vda again"
type_line "vda"
await "Agent OS is installed on vda." 600
eq "a finished install has boot code" 1 "$(( $("$vm" boot-code) > 0 ))"
# No clean shutdown here. Everything the report promises must already be on the disk.
"$vm" kill

echo "### BIOS: a refused confirmation changes nothing"
"$vm" installer "$iso" --keep-disk
start_console
installed_bytes=$("$vm" boot-code)
type_line ""
await "Key: "
type_line "$(cat "$key.pub")"
await "Disk to use: "
type_line "vda"
await "press Enter to erase"
type_line ""
await "Type vda again"
type_line "sda"
await "Nothing was changed."
await "Press Enter to install"
eq "a refused confirmation leaves the boot code" "$installed_bytes" "$("$vm" boot-code)"

echo "### BIOS: a power cut in the middle of a reinstall"
type_line ""
await "Key: "
type_line "$(cat "$key.pub")"
await "Disk to use: "
type_line "vda"
await "press Enter to erase"
type_line ""
await "Type vda again"
type_line "vda"
await "Copying the system."
"$vm" kill
eq "an interrupted install has no boot code" 0 "$("$vm" boot-code)"

echo "### BIOS: the next run finishes"
"$vm" installer "$iso" --keep-disk
start_console
type_line ""
await "Key: "
type_line "$(cat "$key.pub")"
await "Disk to use: "
type_line "vda"
await "press Enter to erase"
type_line ""
await "Type vda again"
type_line "vda"
await "Agent OS is installed on vda." 600
await "press Enter to restart"
reported=$(reported_host_key)
"$vm" kill

echo "### BIOS: the disk boots on its own"
"$vm" up
eq "the host key is the one the installer reported" "$reported" "$(host_key)"
stranger=$(mktemp -d)
ssh-keygen -q -t ed25519 -N "" -f "$stranger/key"
eq "a key that was not enrolled cannot log in" 255 "$(status_of ssh -i "$stranger/key" -p 10022 -o BatchMode=yes -o ConnectTimeout=3 \
	-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null admin@127.0.0.1 true)"
copy_tests
step installer/guest/installed bios
step image/guest/first_boot
step installer/guest/upgrade
"$vm" down
step installer/guest/after_upgrade

echo "### repair: the root is destroyed and the projects stay"
"$vm" ssh 'sudo agentos project create gamma --disk 2G --memory-max 1G >/dev/null'
# A newer installer can give the system agent another UID, which leaves its files with an owner nobody has.
"$vm" ssh 'sudo install -o 54321 -g 54321 /dev/null /var/lib/agent-os/system-agent/stale-owner'
uids=$("$vm" ssh 'for p in alpha gamma; do sudo agentos project inspect $p | sed -n s/^uid=//p; done' | paste -sd' ')
snapshots=$("$vm" ssh 'sudo agentos project snapshots alpha | wc -l')
# Sync first, because nothing on the zeroed root can run afterward, and gamma is seconds old.
"$vm" ssh 'sudo sync; sudo dd if=/dev/zero of=/dev/disk/by-partlabel/agentos-root bs=1M count=64 conv=fsync status=none' || true
"$vm" kill

repair_prompts() {
	start_console
	type_line ""
	await "Key: "
	type_line "$(cat "$key.pub")"
	await "Disk to use: "
	type_line "vda"
	await "press Enter to erase"
	type_line "repair"
}
"$vm" installer "$iso" --keep-disk
repair_prompts
await "Type vda again"
type_line "vda"
await "Copying the system."
"$vm" kill
eq "an interrupted repair has no boot code" 0 "$("$vm" boot-code)"

"$vm" installer "$iso" --keep-disk
repair_prompts
await "Type vda again"
type_line "vda"
await "Agent OS is repaired on vda. Kept 3 projects." 600
await "press Enter to restart"
reported=$(reported_host_key)
"$vm" kill

"$vm" up
eq "the repaired host serves the host key it reported" "$reported" "$(host_key)"
copy_tests
step installer/guest/installed bios
step installer/guest/repaired $uids "$snapshots"
"$vm" ssh 'sudo dd if=/dev/zero of=/dev/disk/by-partlabel/agentos-data bs=1M count=128 conv=fsync status=none; sudo sync' || true
"$vm" kill

echo "### repair: a data partition that cannot be read stops the repair"
"$vm" installer "$iso" --keep-disk
installed_bytes=$("$vm" boot-code)
repair_prompts
await "The data partition cannot be read"
await "Press Enter to install"
eq "a refused repair leaves the boot code" "$installed_bytes" "$("$vm" boot-code)"
"$vm" kill

echo "### UEFI: the key comes from a USB stick"
"$vm" installer "$iso" --uefi --key "$key.pub"
start_console
type_line ""
await "Key: "
type_line ""
await "Disks that can hold Agent OS:"
listing_start=$position
await "Disk to use: "
eq "only the target disk is offered" 1 "$(tail -c +$((listing_start + 1)) "$log" | head -c $((position - listing_start)) | grep -acE '^(vd|sd|sr)')"
eq "the listed disk is the target" 1 "$(tail -c +$((listing_start + 1)) "$log" | head -c $((position - listing_start)) | grep -ac '^vda')"
# The install medium is a 17 GiB stick, large enough to qualify except that it is the medium.
type_line "sda"
await "sda is not one of the listed disks."
await "Disk to use: "
type_line "sdb"
await "sdb is not one of the listed disks."
await "Disk to use: "
type_line "vda"
await "Type vda again"
type_line "vda"
await "Agent OS is installed on vda." 600
await "press Enter to restart"
type_line ""
await "Press Enter to install"
"$vm" kill

echo "### UEFI: the disk boots on its own"
"$vm" up
copy_tests
step installer/guest/installed uefi
"$vm" down
finish
echo "PASS: installer"
