#!/usr/bin/env bash
# Builds and drives the Debian test VM. See doc/TEST_PLAN.md.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
state="$repo/.vm"
source "$here/image.lock"

# .vm/cache holds the verified download. .vm/baseline is immutable after a
# build. .vm/run holds the overlays that `reset` discards.
key="$state/id_ed25519"
disks=(root data)
# UEFI remembers its boot order across boots, so a disk that became bootable later would stay behind its shell.
declare -A boot_index=([root]=,bootindex=1)
container=agentos-test-vm
toolbox=agentos-vm-toolbox:$APT_SNAPSHOT
ssh_port=10022
console_port=10023

in_toolbox() {
	docker run --rm -i --user "$(id -u):$(id -g)" -v "$state:$state" -w "$state" "$toolbox" "$@"
}

running() {
	[[ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" == true ]]
}

guest() {
	ssh -i "$key" -p "$ssh_port" -o BatchMode=yes -o ConnectTimeout=3 \
		-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
		admin@127.0.0.1 "$@"
}

boot() { # <disk dir> [extra qemu args...]
	local dir=$1 name drives=() firmware=()
	shift
	for name in "${disks[@]}"; do
		[[ -f "$dir/$name.qcow2" ]] || continue
		drives+=(-drive "if=none,id=$name,file=$dir/$name.qcow2,format=qcow2"
			-device "virtio-blk-pci,drive=$name,serial=agentos-$name${boot_index[$name]:-}")
	done
	# A machine installed under UEFI keeps its firmware across every later boot.
	[[ ! -f "$dir/efivars.fd" ]] || firmware=(-drive "if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"
		-drive "if=pflash,format=raw,unit=1,file=$dir/efivars.fd")
	docker rm -f "$container" >/dev/null 2>&1 || true
	docker run -d --name "$container" --device /dev/kvm --network host \
		--user "$(id -u):$(id -g)" -v "$state:$state" "$toolbox" \
		qemu-system-x86_64 -name agentos-test -machine q35,accel=kvm -cpu host -smp 4 -m 4G \
		-display none "${firmware[@]}" \
		-chardev "socket,id=console,host=127.0.0.1,port=$console_port,server=on,wait=off,logfile=$state/serial.log" -serial chardev:console \
		-nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$ssh_port-:22" \
		"${drives[@]}" "$@" >/dev/null
	wait_for "$ready"
}

can_log_in() { guest true </dev/null 2>/dev/null; }
sshd_answers() { ssh-keyscan -T 1 -p "$ssh_port" 127.0.0.1 2>/dev/null | grep -q .; }
installer_waits() { grep -q 'Press Enter to install' "$state/serial.log" 2>/dev/null; }
ready=can_log_in

wait_for() { # <check>
	local _
	for _ in $(seq 1 180); do
		if ! running; then
			docker logs "$container" >&2
			echo "vm: QEMU exited during boot. See $state/serial.log" >&2
			exit 1
		fi
		"$1" && return 0
		sleep 1
	done
	echo "vm: SSH did not come up. See $state/serial.log" >&2
	exit 1
}

cmd_down() {
	if running; then
		guest sudo poweroff 2>/dev/null || true
		local _
		for _ in $(seq 1 60); do
			running || break
			sleep 1
		done
		running && docker stop -t 5 "$container" >/dev/null
	fi
	docker rm -f "$container" >/dev/null 2>&1 || true
}

fetch_image() {
	local image
	image="$state/cache/$(basename "$IMAGE_URL")"
	if [[ ! -f "$image" ]]; then
		mkdir -p "$state/cache"
		curl -fL --retry 3 -o "$image.part" "$IMAGE_URL"
		mv "$image.part" "$image"
	fi
	echo "$IMAGE_SHA512  $image" | sha512sum -c --quiet >&2
	echo "$image"
}

cmd_build() {
	if [[ -d "$state/baseline" && "${1:-}" != --force ]]; then
		echo "vm: baseline already built"
		return
	fi
	cmd_down
	mkdir -p "$state"
	docker build -q --build-arg "APT_SNAPSHOT=$APT_SNAPSHOT" -t "$toolbox" "$here" >/dev/null
	[[ -f "$key" ]] || ssh-keygen -q -t ed25519 -N '' -C agentos-test-vm -f "$key"
	local image work="$state/baseline.tmp"
	image="$(fetch_image)"
	chmod -R u+w "$work" 2>/dev/null || true
	rm -rf "$work"
	mkdir -p "$work"
	cp --reflink=auto "$image" "$work/root.qcow2"
	in_toolbox qemu-img resize -q "$work/root.qcow2" 20G
	in_toolbox qemu-img create -q -f qcow2 "$work/data.qcow2" 20G
	sed -e "s|@SSH_KEY@|$(cat "$key.pub")|" -e "s|@APT_SNAPSHOT@|$APT_SNAPSHOT|" \
		"$here/user-data.tmpl" > "$work/user-data"
	printf 'instance-id: agentos-baseline\nlocal-hostname: agentos-test\n' > "$work/meta-data"
	in_toolbox cloud-localds "$work/seed.iso" "$work/user-data" "$work/meta-data"
	boot "$work" -drive "if=virtio,file=$work/seed.iso,format=raw,readonly=on"
	guest cloud-init status --wait
	guest 'dpkg-query -W -f "\${Package} \${Version}\n"' > "$work/packages.txt"
	cmd_down
	rm -f "$work/seed.iso" "$work/user-data" "$work/meta-data"
	chmod -R a-w "$work"
	chmod -R u+w "$state/baseline" 2>/dev/null || true
	rm -rf "$state/baseline"
	chmod u+w "$work"
	mv "$work" "$state/baseline"
	chmod a-w "$state/baseline"
	cmd_reset
	echo "vm: baseline ready"
}

cmd_kill() { docker rm -f "$container" >/dev/null 2>&1 || true; }

cmd_reset() {
	cmd_down
	rm -rf "$state/run"
	mkdir -p "$state/run"
	local name
	for name in "${disks[@]}"; do
		in_toolbox qemu-img create -q -f qcow2 -F qcow2 \
			-b "$state/baseline/$name.qcow2" "$state/run/$name.qcow2"
	done
}

cmd_image() { # <image> [--no-key]
	local image=$1 credential=()
	if [[ "${2:-}" == --no-key ]]; then
		ready=sshd_answers
	else
		credential=(-smbios "type=11,value=io.systemd.credential.binary:ssh.authorized_keys.admin=$(base64 -w0 "$key.pub")")
	fi
	cmd_kill
	rm -rf "$state/run"
	mkdir -p "$state/run"
	cp --reflink=auto "$image" "$state/run/root.qcow2"
	# More disk than the image was built with, as a hypervisor would give it.
	in_toolbox qemu-img resize -q "$state/run/root.qcow2" 24G
	boot "$state/run" "${credential[@]}"
}

cmd_installer() { # <iso> [--uefi] [--keep-disk] [--key FILE]
	local iso=$1 uefi=false keep=false key_file="" medium extra=()
	shift
	while (($#)); do
		case "$1" in
			--uefi) uefi=true ;;
			--keep-disk) keep=true ;;
			--key) key_file=$2; shift ;;
			*) echo "vm: unknown installer option $1" >&2; exit 2 ;;
		esac
		shift
	done
	cmd_kill
	if [[ $keep == false ]]; then
		rm -rf "$state/run"
		mkdir -p "$state/run"
		in_toolbox qemu-img create -q -f qcow2 "$state/run/root.qcow2" 24G
		[[ $uefi == false ]] || in_toolbox cp /usr/share/OVMF/OVMF_VARS_4M.fd "$state/run/efivars.fd"
	fi
	medium=$state/run/installer.img
	cp --reflink=auto "$iso" "$medium"
	if [[ $uefi == true ]]; then
		# Writable and larger than the smallest target, so only the medium check keeps it off the list.
		truncate -s 17G "$medium"
		extra+=(-device qemu-xhci -drive "if=none,id=medium,file=$medium,format=raw"
			-device "usb-storage,drive=medium,bootindex=0")
	else
		extra+=(-drive "if=none,id=medium,file=$medium,format=raw,readonly=on,media=cdrom"
			-device "ide-cd,drive=medium,bootindex=0")
	fi
	if [[ -n $key_file ]]; then
		[[ $uefi == true ]] || extra+=(-device qemu-xhci)
		cp "$key_file" "$state/run/agentos-admin.pub"
		in_toolbox bash -c "rm -f run/key.img; mkfs.vfat -C run/key.img 8192 >/dev/null; mcopy -i run/key.img run/agentos-admin.pub ::agentos-admin.pub"
		extra+=(-drive "if=none,id=stick,file=$state/run/key.img,format=raw" -device usb-storage,drive=stick)
	fi
	ready=installer_waits
	boot "$state/run" "${extra[@]}"
}

# Counts the non-zero bytes of the root disk's boot code. Zero means firmware cannot start it. Works while the VM runs.
cmd_boot_code() {
	rm -f "$state/run/boot-code.bin"
	in_toolbox qemu-img dd -U -f qcow2 -O raw bs=440 count=1 if="$state/run/root.qcow2" of="$state/run/boot-code.bin"
	tr -d '\0' < "$state/run/boot-code.bin" | wc -c
	rm -f "$state/run/boot-code.bin"
}

cmd_export_data() { # <output under .vm>
	in_toolbox qemu-img convert -c -O qcow2 "$state/run/data.qcow2" "$1"
}

cmd_up() {
	running && return 0
	[[ -f "$state/run/root.qcow2" ]] || cmd_reset
	boot "$state/run"
}

cmd_snapshot() {
	local action=${1:-} label=${2:-} flag name
	case "$action" in
		save) flag=-c ;;
		restore) flag=-a ;;
		list) in_toolbox qemu-img snapshot -l "$state/run/root.qcow2"; return ;;
		*) echo "usage: vm snapshot save|restore NAME, or vm snapshot list" >&2; exit 2 ;;
	esac
	[[ "$label" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "vm: invalid snapshot name" >&2; exit 2; }
	# qcow2 internal snapshots are only consistent while QEMU has the disk closed.
	cmd_down
	for name in "${disks[@]}"; do
		in_toolbox qemu-img snapshot "$flag" "$label" "$state/run/$name.qcow2"
	done
}

case "${1:-}" in
	build) shift; cmd_build "$@" ;;
	up) cmd_up ;;
	down) cmd_down ;;
	reset) cmd_reset ;;
	kill) cmd_kill ;;
	image) shift; cmd_image "$@" ;;
	installer) shift; cmd_installer "$@" ;;
	boot-code) cmd_boot_code ;;
	export-data) shift; cmd_export_data "$@" ;;
	snapshot) shift; cmd_snapshot "$@" ;;
	ssh) shift; cmd_up; guest "$@" ;;
	*) echo "usage: vm build [--force]|up|down|kill|reset|image FILE [--no-key]|installer ISO [--uefi] [--keep-disk] [--key FILE]|export-data FILE|ssh [cmd]|snapshot ..." >&2; exit 2 ;;
esac
