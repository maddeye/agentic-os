#!/usr/bin/env bash
# Resets the VM and installs this checkout into it. Test files go to /opt/aos-tests.
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
vm="$repo/tests/vm/vm"
"$vm" reset
"$vm" up
tar -C "$repo" -cf - bin configs packaging tests \
	| "$vm" ssh 'sudo mkdir -p /opt/aos-tests && sudo tar -C /opt/aos-tests --no-same-owner -xf - && sudo chmod -R a+rX /opt/aos-tests'
"$vm" ssh 'sudo /opt/aos-tests/packaging/install.sh'
